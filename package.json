{
  "name": "vue3-memorystats",
  "version": "0.2.2",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/vue3-memorystats.umd.js",
  "module": "./dist/vue3-memorystats.es.js",
  "exports": {
    ".": {
      "import": "./dist/vue3-memorystats.es.js",
      "require": "./dist/vue3-memorystats.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "Rohil Visariya",
  "homepage": "https://github.com/rohilv/vue3-memorystats",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohilv/vue3-memorystats.git"
  },
  "bugs": {
    "email": "github@rohilv.com",
    "url": "https://github.com/rohilv/vue3-memorystats/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "lint:ci": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "prepublishOnly": "npm run build-only"
  },
  "dependencies": {
    "vue": "^3.4.29"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.8.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "npm-run-all2": "^6.2.0",
    "prettier": "^3.2.5",
    "vite": "^5.3.1"
  },
  "keywords": [
    "memorystats",
    "vue3 memory",
    "memory status",
    "memory stats"
  ]
}
